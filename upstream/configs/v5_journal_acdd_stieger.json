  "method_contract": {
    "name": "Access-Conditioned Decision Decomposition v2",
    "discrimination_headroom": "D_m=max_tau BA(s_m,tau)-0.5=J_m_star/2",
    "decision_loss": "E_m=max_tau BA(s_m,tau)-BA(s_m,tau_m)",
    "exact_identity": "BA_m-0.5=D_m-E_m",
    "comparison_identity": "Delta_BA=(D_m-D_0)+(E_0-E_m)",
    "normalized_recovery_scope": "reported only for rank-preserving methods that declare and empirically preserve score order",
    "auc_role": "AUROC is reported separately and is not equated with D_m",
    "unlabeled_identifiability_boundary": "the optimal balanced-accuracy threshold is not identified by the unlabeled score marginal without additional assumptions"
  },
  "access_information_sets": {
    "prefix10_suffix": "threshold is measurable with respect to the first ten unlabeled acquisition-ordered scores and is frozen before trial 11",
    "prequential": "the threshold for trial t is measurable only with respect to scores 1 through t-1",
    "session1_to_later": "the threshold is measurable only with respect to unlabeled first-session scores",
    "full_prior_upper_bound": "uses future target scores and is transductive, not online",
    "oracle": "uses target labels and is diagnostic only"
  },
