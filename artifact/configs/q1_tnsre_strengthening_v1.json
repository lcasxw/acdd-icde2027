  "endpoints": ["prefix_suffix", "prequential", "session1_to_later", "full_prior"],
  "prefix_lengths": [5, 10, 20, 50],
  "primary_metric": "balanced_accuracy",
  "si_metrics": ["macro_f1", "weighted_recall_0.25_0.75"],
  "harm_definitions": {"any_negative": 0.0, "practical": -0.02},
  "weighting_estimands": ["participant_weighted", "protocol_balanced", "dataset_balanced"],
  "reporting_guards": {
    "cross_access_ranking_prohibited": true,
    "target_labels_available_to_deployable_fit": false,
    "full_batch_may_be_called_online": false,
    "oracle_may_be_called_deployable": false,
    "stieger_result_language": "statistically reliable but modest mixed result"
  }
